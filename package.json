{
  "name": "cassycas",
  "private": true,
  "description": "Browser-native symbolic workstation (single HTML file).",
  "type": "module",
  "bin": {
    "cassycas": "bin/cassycas.mjs",
    "cassycas-lsp": "bin/cassycas-lsp.mjs"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:setup": "node tests/setup.mjs && playwright install chromium",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "build:single": "vite build --mode single",
    "bench": "node tests/bench/run.mjs",
    "cas": "node bin/cassycas.mjs",
    "lsp": "node bin/cassycas-lsp.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.4",
    "codemirror": "^6.0.1",
    "katex": "^0.16.11"
  },
  "devDependencies": {
    "algebrite": "^1.4.0",
    "mathjs": "^12.4.2",
    "mathlive": "^0.98.6",
    "playwright": "^1.55.0",
    "plotly.js-dist-min": "^2.27.0",
    "pyodide": "314.0.7",
    "vite": "^5.4.21",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
